<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fallback">

    <!-- Fondo: dos capas para el crossfade -->
    <ImageView
        android:id="@+id/wallFront"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/wallBack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Fondo de video (loop, mudo); entra y sale con fade -->
    <TextureView
        android:id="@+id/wallVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Scrim para legibilidad del reloj y del dock -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <!-- Widgets: reloj, fecha, saludo y clima. Siguen visibles cuando se oculta el menú. -->
    <include layout="@layout/widgets_header" />

    <!-- Vista "solo wallpaper" (menú oculto): reloj centrado y grande, clima y reproductor -->
    <include layout="@layout/widgets_showcase" />

    <!-- Menú: una fila por sección; el scroll vertical muestra una a la vez (la altura se ajusta en código) -->
    <ScrollView
        android:id="@+id/dockScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_glass"
        android:clipToPadding="false"
        android:fadingEdgeLength="36dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
    </ScrollView>

    <!-- Ayuda del modo "mover" -->
    <TextView
        android:id="@+id/moveHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="270dp"
        android:paddingStart="26dp"
        android:paddingTop="12dp"
        android:paddingEnd="26dp"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Aviso al ocultar el menú -->
    <TextView
        android:id="@+id/cleanHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="34dp"
        android:alpha="0"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="8"
        android:text="@string/clean_hint"
        android:textColor="#CCFFFFFF"
        android:textSize="16sp" />

    <!-- Bienvenida: breve, al arrancar el TV o el launcher -->
    <LinearLayout
        android:id="@+id/greeting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#99000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:shadowColor="#99000000"
            android:shadowDy="3"
            android:shadowRadius="16"
            android:text="@string/welcome"
            android:textColor="#FFFFFF"
            android:textSize="60sp" />

        <View
            android:id="@+id/welcomeLine"
            android:layout_width="120dp"
            android:layout_height="3dp"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
